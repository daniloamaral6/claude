# Copie para .env e ajuste. Nunca versione o .env.
# Em produção, defina estas variáveis no painel da hospedagem (não em arquivo).

# Banco (PostgreSQL)
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/afeturar
# Só para rodar os testes (banco separado, será apagado a cada execução)
TEST_DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/afeturar_test

# Site
NEXT_PUBLIC_SITE_URL=https://www.afeturar.com.br
# Buscadores só entram quando for "true". Deixe vazio até o site oficial estar pronto.
NEXT_PUBLIC_INDEXAR=

# Fotos enviadas pelo painel (pasta persistente da hospedagem ou, no futuro, armazenamento em nuvem)
STORAGE_DIR=./storage/uploads

# Mercado Pago (Pix e cartão)
MERCADO_PAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
# Só enquanto testar com credenciais que recusam pagamento de teste ("Unauthorized use of live credentials"). REMOVER ao abrir a loja.
# MERCADO_PAGO_MODO_TESTE=true

# Melhor Envio (frete). Ambiente: sandbox ou producao
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_AMBIENTE=sandbox
MELHOR_ENVIO_EMAIL_CONTATO=

# E-mails (Resend)
RESEND_API_KEY=
EMAIL_REMETENTE=

# Segredo da rotina que cancela pedidos vencidos (GET /api/cron/expirar-pedidos com "Authorization: Bearer <segredo>")
CRON_SECRET=

# SOMENTE desenvolvimento: simulam frete e pagamento. O pagamento simulado é bloqueado em produção.
# FRETE_SIMULADO=true
# PAGAMENTO_SIMULADO=true
